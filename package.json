{
  "name": "moonsec",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "art:rig": "node --import ./tools/register-ts.mjs tools/rig/build.ts",
    "art:palette": "node --import ./tools/register-ts.mjs tools/palette/export.ts && node --import ./tools/register-ts.mjs tools/palette/remap.ts",
    "shots": "node tools/shots/shots.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
